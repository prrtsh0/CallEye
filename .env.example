# CallEye configuration
# Copy to .env and fill in real values. NEVER commit .env.

APP_NAME=CallEye

# "mock" requires no network/key; "live" talks to Gnani Prisma.
GNANI_MODE=mock

# Gnani credentials (leave blank in mock mode)
GNANI_API_KEY=
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3
GNANI_TTS_URL=
# Evon reasoning model (plain-language explanations). Leave blank in mock mode.
GNANI_EVON_URL=
GNANI_EVON_API_KEY=
GNANI_EVON_MODEL=evon

# Access & abuse controls
# Comma-separated invite codes (empty = live mode open)
INVITE_CODES=
SESSION_MAX_SECONDS=90
DAILY_CAP_PER_DEVICE=10
# Set to 1 to force mock mode globally
GLOBAL_KILL_SWITCH=0
CREDIT_FLOOR=1000
STT_CREDITS_PER_MINUTE=0.33

# Database
# Leave empty for local SQLite (data/calleye.db). For a managed, persistent
# store, set to a Neon Postgres DSN: postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# Admin
ADMIN_TOKEN=
ALLOWED_ORIGINS=
LOG_LEVEL=info
